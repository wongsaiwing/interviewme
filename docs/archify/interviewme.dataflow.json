      "width": 150
    }
  ],
  "flows": [
    {
      "id": "facts-to-embed",
      "from": "facts",
      "to": "embed",
      "label": "markdown chunks",
      "classification": "facts only",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": 56
    },
    {
      "id": "embed-to-vectors",
      "from": "embed",
      "to": "vectors",
      "label": "256-d hashes",
      "classification": "RAM vectors",
      "variant": "emphasis",
      "route": "straight",
      "labelDy": 56
    },
    {
      "id": "vectors-to-prompt",
      "from": "vectors",
      "to": "prompt",
      "label": "similarity search",
      "classification": "top chunks",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "id": "chrome-to-prompt",
      "from": "chrome",
      "to": "prompt",
      "label": "chat query",
      "classification": "request only",
      "variant": "emphasis",
      "route": "bottom-channel"
    },
    {
      "id": "tone-to-prompt",
      "from": "tone",
      "to": "prompt",
      "label": "system prompt",
      "classification": "not vectored",
      "variant": "dashed",
      "route": "straight"
    },
    {
      "id": "chrome-to-memory",
      "from": "chrome",
      "to": "memory",
      "label": "volatile session",
      "classification": "not persisted",
      "variant": "dashed",
      "route": "straight"
    },
    {
      "id": "prompt-to-deepseek",
      "from": "prompt",
      "to": "deepseek",
      "label": "grounded prompt",
      "classification": "API key server-only",
      "variant": "emphasis",
      "route": "vertical-channel"
    },
    {
      "id": "deepseek-to-guard",
      "from": "deepseek",
      "to": "guard",
      "label": "buffered tokens",
      "classification": "model output",
      "variant": "default",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 24
    },
    {
      "id": "guard-to-spa",
      "from": "guard",
      "to": "spa",
      "label": "SSE tokens",
      "classification": "filtered text",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top",
      "route": "straight",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Facts to vectors",
      "items": [
        "knowledge/facts markdown is split and hashed by HashingEmbeddingClient at process start",
        "Vectors live in LangChainVectorStore in RAM at 256 dimensions. There is no Postgres or Redis",
        "knowledge/tone never enters the vector store; it is concatenated into the system prompt only"
      ]
    },
    {
      "dot": "cyan",
      "title": "Query to prompt",
      "items": [
        "A visitor query is embedded with the same local hasher and searched against RAM vectors",
        "Retrieved chunks plus tone go to PromptBuilder inside InterviewMe.Api",
        "The SPA never talks to DeepSeek. Only /api is visible in the browser"
      ]
    },
    {
      "dot": "rose",
      "title": "Key and chat policy",
      "items": [
        "The DeepSeek API key is held on the server HttpClient and is never sent to Chrome",
        "Visitor transcripts sit in InMemoryConversationStore for the request only and are not persisted",
        "BiographyGuard filters output before SSE tokens reach the CLI"
      ]
    }
  ]
}
