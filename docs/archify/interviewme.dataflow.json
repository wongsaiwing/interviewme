{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "InterviewMe Data Flow",
    "locale": "en",
    "output": "/workspace/archify-out/interviewme.dataflow.html",
    "quality_profile": "showcase",
    "viewBox": [
      1080,
      720
    ],
    "views": [
      {
        "id": "facts-embed",
        "label": "Facts to RAM vectors",
        "focus": [
          "facts",
          "embed",
          "vectors"
        ],
        "note": "knowledge/facts markdown is split, hashed, and stored as 256-d vectors in RAM at startup."
      },
      {
        "id": "query-prompt",
        "label": "Query to prompt",
        "focus": [
          "chrome",
          "vectors",
          "tone",
          "prompt"
        ],
        "note": "A visitor query searches RAM vectors. Tone is injected as prompt text and is never vectored."
      },
      {
        "id": "key-and-ephemeral",
        "label": "Key and chat policy",
        "focus": [
          "prompt",
          "deepseek",
          "guard",
          "spa",
          "memory"
        ],
        "note": "The DeepSeek key stays on the server. Visitor chat is volatile RAM only and is not persisted."
      }
    ]
  },
  "stages": [
    {
      "label": "Sources"
    },
    {
      "label": "Embed"
    },
    {
      "label": "RAM store"
    },
    {
      "label": "Retrieve / prompt"
    },
    {
      "label": "Generate / deliver"
    }
  ],
  "nodes": [
    {
      "id": "facts",
      "type": "database",
      "label": "knowledge/facts",
      "sublabel": "markdown",
      "stage": 0,
      "row": 0,
      "tag": "ingest at startup",
      "width": 150
    },
    {
      "id": "chrome",
      "type": "frontend",
      "label": "Visitor chat",
      "sublabel": "Chrome CLI query",
      "stage": 0,
      "row": 4,
      "tag": "not persisted",
      "width": 150
    },
    {
      "id": "embed",
      "type": "backend",
      "label": "HashingEmbeddingClient",
      "sublabel": "local 256-d hashes",
      "stage": 1,
      "row": 0,
      "tag": "no OpenAI embed",
      "width": 176
    },
    {
      "id": "tone",
      "type": "backend",
      "label": "knowledge/tone",
      "sublabel": "prompt only",
      "stage": 0,
      "row": 2,
      "tag": "not vectored",
      "width": 150
    },
    {
      "id": "vectors",
      "type": "database",
      "label": "LangChainVectorStore",
      "sublabel": "in-memory 256-d",
      "stage": 2,
      "row": 0,
      "tag": "RAM",
      "width": 170
    },
    {
      "id": "memory",
      "type": "database",
      "label": "InMemoryConversationStore",
      "sublabel": "volatile session",
      "stage": 2,
      "row": 4,
      "tag": "not persisted",
      "width": 186
    },
    {
      "id": "prompt",
      "type": "backend",
      "label": "PromptBuilder",
      "sublabel": "ChatUseCase",
      "stage": 3,
      "row": 2,
