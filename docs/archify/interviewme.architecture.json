  "cards": [
    {
      "dot": "cyan",
      "title": "Primary path",
      "items": [
        "HR Chrome fetch POST /api/chat/stream hits nginx, then InterviewMe.Api ChatUseCase",
        "RAG retrieve feeds PromptBuilder; DeepSeek streams tokens; BiographyGuard filters; SSE returns to the CLI",
        "MapGet /api/profile and MapPost /api/chat/stream are the only browser APIs"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundary",
      "items": [
        "The browser sees only /api on www.swwdomain.hk; SPA files live in wwwroot on the same origin",
        "DeepSeek is called from server HttpClient. The API key and knowledge markdown never leave the BFF",
        "nginx terminates TLS with Let's Encrypt and HSTS; it does not hold the model key"
      ]
    },
    {
      "dot": "amber",
      "title": "Short-circuit and memory",
      "items": [
        "Injection or off-topic questions get a canned refuse inside ChatUseCase; DeepSeek is skipped",
        "knowledge/facts is hashed into the in-memory 256-d store at startup; knowledge/tone is prompt-only",
        "InMemoryConversationStore and InMemoryRateLimiter stay in RAM. Visitor chat is not persisted"
      ]
    }
  ]
}
