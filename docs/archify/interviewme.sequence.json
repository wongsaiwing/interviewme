  "cards": [
    {
      "dot": "rose",
      "title": "Off-topic skip",
      "items": [
        "ChatUseCase classifies injection and off-topic turns before any model call",
        "A canned refuse is streamed as SSE. DeepSeek and RAG are not touched",
        "InMemoryRateLimiter still applies; the visitor transcript is not persisted"
      ]
    },
    {
      "dot": "emerald",
      "title": "On-topic path",
      "items": [
        "The BFF retrieves hashed 256-d chunks from the in-memory LangChain store",
        "PromptBuilder sends a grounded prompt through server HttpClient to DeepSeek",
        "Tokens are buffered, passed through BiographyGuard, then SSE to Chrome"
      ]
    },
    {
      "dot": "cyan",
      "title": "Trust on the wire",
      "items": [
        "The SPA only calls /api; the DeepSeek key never enters the browser",
        "nginx terminates TLS and reverse-proxies both wwwroot and /api on the same origin",
        "Empty retrieval must not invent biography; BiographyGuard enforces that on output"
      ]
    }
  ]
