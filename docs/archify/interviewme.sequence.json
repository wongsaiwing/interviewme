        "note": "On-topic chat retrieves 256-d chunks, prompts DeepSeek, then BiographyGuard filters SSE tokens."
      },
      {
        "id": "sse-return",
        "label": "SSE return to CLI",
        "focus": [
          "guard",
          "bff",
          "nginx",
          "chrome"
        ],
        "note": "Filtered tokens stream back through nginx to the Chrome SPA. Chat is not persisted."
      }
    ]
